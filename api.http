@baseUrl = http://localhost:3000/api/v1
@cookieName = access_token
@adminEmail = Admin@example.com
@adminPassword = ChangeMe123!
@editorEmail = editor.api@example.com
@editorPassword = EditorPass123!
@articleId = 000000000000000000000001
@categoryId = 000000000000000000000002
@authorId = 000000000000000000000003
@imageId = 000000000000000000000004
@userId = 000000000000000000000005
@slug = articulo-prueba-api

@adminCookie = access_token=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJ1c2VySWQiOiI2OWQ3MjJiZmUwMzQ1ZDM5YmU2NmEzYTciLCJlbWFpbCI6ImM0cmxvc3J1aXowMUBnbWFpbC5jb20iLCJyb2xlIjoiYWRtaW4iLCJpYXQiOjE3NzU3OTM2NTIsImV4cCI6MTc3NTg4MDA1Mn0.cMinVuiQhWCyPZc3h10Y2_6fz4aDKm6L_GQ4DWR7V1M
@editorCookie = access_token=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJ1c2VySWQiOiI2OWQ3MjJiZmUwMzQ1ZDM5YmU2NmEzYTciLCJlbWFpbCI6ImM0cmxvc3J1aXowMUBnbWFpbC5jb20iLCJyb2xlIjoiYWRtaW4iLCJpYXQiOjE3NzU3OTM2NTIsImV4cCI6MTc3NTg4MDA1Mn0.cMinVuiQhWCyPZc3h10Y2_6fz4aDKm6L_GQ4DWR7V1M
@editorNewPassword = EditorPass123!New
@categorySlug = tecnologia-api
@invalidId = not-a-valid-objectid
@invalidSlug = slug-que-no-existe

# Notes:
# 1) Run login first. If REST Client does not persist cookies, copy Set-Cookie manually into @adminCookie/@editorCookie.
# 2) Expected cookie format: <cookieName>=<jwt>. If cookie name differs, update @adminCookie/@editorCookie.
# 3) After create requests, copy returned ids/slugs to @userId, @categoryId, @authorId, @imageId, @articleId, @slug, @categorySlug.
# 4) For image upload, place a real file at ./uploads/test-image.jpg.

### ==================================================================
### Auth
### ==================================================================

### Auth - Invalid login (negative)
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "{{adminEmail}}",
  "password": "WrongPass123!"
}

###

### Auth - Login admin
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "{{adminEmail}}",
  "password": "{{adminPassword}}"
}

###

### Auth - Me (requires cookie)
GET {{baseUrl}}/auth/me
Cookie: {{adminCookie}}

###

### Auth - Me without cookie (negative)
GET {{baseUrl}}/auth/me

###

### Auth - Register editor user (admin only)
POST {{baseUrl}}/auth/register
Content-Type: application/json
Cookie: {{adminCookie}}

{
  "name": "Editor API Test",
  "email": "{{editorEmail}}",
  "password": "{{editorPassword}}",
  "role": "editor"
}

###

### Auth - Register with invalid body (negative)
POST {{baseUrl}}/auth/register
Content-Type: application/json
Cookie: {{adminCookie}}

{
  "name": "A",
  "email": "bad-email",
  "password": "123",
  "role": "editor"
}

###

### Auth - Users list (admin only)
GET {{baseUrl}}/auth/users
Cookie: {{adminCookie}}

###

### Auth - Update role (admin only)
PATCH {{baseUrl}}/auth/users/{{userId}}/role
Content-Type: application/json
Cookie: {{adminCookie}}

{
  "role": "editor"
}

###

### Auth - Update active false (admin only)
PATCH {{baseUrl}}/auth/users/{{userId}}/active
Content-Type: application/json
Cookie: {{adminCookie}}

{
  "active": false
}

###

### Auth - Update active true (admin only)
PATCH {{baseUrl}}/auth/users/{{userId}}/active
Content-Type: application/json
Cookie: {{adminCookie}}

{
  "active": true
}

###

### Auth - Login editor
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "{{editorEmail}}",
  "password": "{{editorPassword}}"
}

###

### Auth - Forbidden by role (editor cannot list users) (negative)
GET {{baseUrl}}/auth/users
Cookie: {{editorCookie}}

###

### Auth - Change password invalid body (same password) (negative)
POST {{baseUrl}}/auth/change-password
Content-Type: application/json
Cookie: {{editorCookie}}

{
  "currentPassword": "{{editorPassword}}",
  "newPassword": "{{editorPassword}}"
}

###

### Auth - Change password (editor)
POST {{baseUrl}}/auth/change-password
Content-Type: application/json
Cookie: {{editorCookie}}

{
  "currentPassword": "{{editorPassword}}",
  "newPassword": "{{editorNewPassword}}"
}

###

### Auth - Revert editor password (optional)
POST {{baseUrl}}/auth/change-password
Content-Type: application/json
Cookie: {{editorCookie}}

{
  "currentPassword": "{{editorNewPassword}}",
  "newPassword": "{{editorPassword}}"
}

###

### Auth - Logout editor
POST {{baseUrl}}/auth/logout
Cookie: {{editorCookie}}

### ==================================================================
### Dashboard
### ==================================================================

### Dashboard - Summary
GET {{baseUrl}}/dashboard/summary
Cookie: {{adminCookie}}

###

### Dashboard - Summary without cookie (negative)
GET {{baseUrl}}/dashboard/summary

### ==================================================================
### Category
### ==================================================================

### Category - List
GET {{baseUrl}}/category

###

### Category - Create (admin)
POST {{baseUrl}}/category
Content-Type: application/json
Cookie: {{adminCookie}}

{
  "name": "Tecnología API",
  "slug": "tecnologia-api",
  "description": "Categoría creada desde api.http"
}

###

### Category - Duplicate slug (negative)
POST {{baseUrl}}/category
Content-Type: application/json
Cookie: {{adminCookie}}

{
  "name": "Tecnología API Duplicada",
  "slug": "tecnologia-api",
  "description": "Debe responder conflicto por slug"
}

###

### Category - Invalid body (negative)
POST {{baseUrl}}/category
Content-Type: application/json
Cookie: {{adminCookie}}

{
  "name": "A",
  "description": "Nombre demasiado corto"
}

###

### Category - Get by id
GET {{baseUrl}}/category/{{categoryId}}

###

### Category - Get by slug
GET {{baseUrl}}/category/slug/{{categorySlug}}

###

### Category - Invalid id (negative)
GET {{baseUrl}}/category/{{invalidId}}

###

### Category - Invalid slug (negative)
GET {{baseUrl}}/category/slug/%20

###

### Category - Update (admin)
PATCH {{baseUrl}}/category/{{categoryId}}
Content-Type: application/json
Cookie: {{adminCookie}}

{
  "description": "Descripción actualizada desde api.http"
}

###

### Category - Delete (admin, run after deleting dependent articles)
DELETE {{baseUrl}}/category/{{categoryId}}
Cookie: {{adminCookie}}

### ==================================================================
### Author
### ==================================================================

### Author - List
GET {{baseUrl}}/author

###

### Author - Create (admin)
POST {{baseUrl}}/author
Content-Type: application/json
Cookie: {{adminCookie}}

{
  "name": "Ada Lovelace",
  "bio": "Autora de prueba para endpoints de API",
  "avatarUrl": "https://example.com/avatars/ada-lovelace.jpg"
}

###

### Author - Invalid body (negative)
POST {{baseUrl}}/author
Content-Type: application/json
Cookie: {{adminCookie}}

{
  "name": "B",
  "avatarUrl": "no-es-url"
}

###

### Author - Get by id
GET {{baseUrl}}/author/{{authorId}}

###

### Author - Invalid id (negative)
GET {{baseUrl}}/author/{{invalidId}}

###

### Author - Get author articles (public scope)
GET {{baseUrl}}/author/{{authorId}}/articles?scope=public

###

### Author - Get author articles (all scope, admin)
GET {{baseUrl}}/author/{{authorId}}/articles?scope=all
Cookie: {{adminCookie}}

###

### Author - Forbidden all scope for non-admin (negative)
GET {{baseUrl}}/author/{{authorId}}/articles?scope=all
Cookie: {{editorCookie}}

###

### Author - Update (admin)
PATCH {{baseUrl}}/author/{{authorId}}
Content-Type: application/json
Cookie: {{adminCookie}}

{
  "bio": "Bio actualizada para pruebas de integración"
}

###

### Author - Delete (admin, run after deleting dependent articles)
DELETE {{baseUrl}}/author/{{authorId}}
Cookie: {{adminCookie}}

### ==================================================================
### Image
### ==================================================================

### Image - List recent (admin|editor)
GET {{baseUrl}}/image?limit=10
Cookie: {{adminCookie}}

###

### Image - Upload (multipart/form-data)
POST {{baseUrl}}/image/upload
Cookie: {{adminCookie}}
Content-Type: multipart/form-data; boundary=----PeriodicoBoundary7MA4YWxkTrZu0gW

------PeriodicoBoundary7MA4YWxkTrZu0gW
Content-Disposition: form-data; name="image"; filename="test-image.jpg"
Content-Type: image/jpeg

< ./uploads/test-image.jpg
------PeriodicoBoundary7MA4YWxkTrZu0gW--

###

### Image - Invalid id (negative)
DELETE {{baseUrl}}/image/{{invalidId}}
Cookie: {{adminCookie}}

###

### Image - Delete (admin|editor, run after article cleanup)
DELETE {{baseUrl}}/image/{{imageId}}
Cookie: {{adminCookie}}

### ==================================================================
### Article
### ==================================================================

### Article - List all
GET {{baseUrl}}/article

###

### Article - List with query params
GET {{baseUrl}}/article?status=draft&q=api&page=1&limit=10

###

### Article - Invalid body create (negative)
POST {{baseUrl}}/article
Content-Type: application/json
Cookie: {{editorCookie}}

{
  "title": "AB",
  "excerpt": "x",
  "content": "corto",
  "status": "draft",
  "isFeatured": false,
  "authorId": "{{authorId}}",
  "categoryIds": ["{{categoryId}}"]
}

###

### Article - Create (admin|editor)
POST {{baseUrl}}/article
Content-Type: application/json
Cookie: {{editorCookie}}

{
  "title": "Guía completa de pruebas API REST",
  "slug": "{{slug}}",
  "excerpt": "Checklist real para validar endpoints en Express",
  "content": "Este artículo de prueba se usa para validar create, update, feature, status, publish-now, duplicate y delete.",
  "featuredImageUrl": "/uploads/featured/test-image.jpg",
  "status": "draft",
  "isFeatured": false,
  "authorId": "{{authorId}}",
  "categoryIds": ["{{categoryId}}"]
}

###

### Article - Get by id
GET {{baseUrl}}/article/{{articleId}}

###

### Article - Get by slug
GET {{baseUrl}}/article/slug/{{slug}}

###

### Article - Invalid id (negative)
GET {{baseUrl}}/article/{{invalidId}}

###

### Article - Invalid slug (negative)
GET {{baseUrl}}/article/slug/{{invalidSlug}}

###

### Article - Update (admin|editor)
PATCH {{baseUrl}}/article/{{articleId}}
Content-Type: application/json
Cookie: {{editorCookie}}

{
  "title": "Guía actualizada de pruebas API REST",
  "excerpt": "Checklist actualizado para QA API",
  "content": "Contenido actualizado para probar PATCH /article/:id.",
  "isFeatured": false
}

###

### Article - Status invalid body (scheduled without scheduledAt) (negative)
PATCH {{baseUrl}}/article/{{articleId}}/status
Content-Type: application/json
Cookie: {{adminCookie}}

{
  "status": "scheduled"
}

###

### Article - Forbidden by role (editor cannot change status) (negative)
PATCH {{baseUrl}}/article/{{articleId}}/status
Content-Type: application/json
Cookie: {{editorCookie}}

{
  "status": "draft"
}

###

### Article - Feature (admin)
PATCH {{baseUrl}}/article/{{articleId}}/feature
Content-Type: application/json
Cookie: {{adminCookie}}

{
  "isFeatured": true
}

###

### Article - Update status to scheduled (admin)
PATCH {{baseUrl}}/article/{{articleId}}/status
Content-Type: application/json
Cookie: {{adminCookie}}

{
  "status": "scheduled",
  "scheduledAt": "2030-01-01T10:00:00.000Z"
}

###

### Article - Publish now (admin)
POST {{baseUrl}}/article/{{articleId}}/publish-now
Cookie: {{adminCookie}}

###

### Article - Duplicate (admin|editor)
POST {{baseUrl}}/article/{{articleId}}/duplicate
Cookie: {{editorCookie}}

###

### Article - Delete (admin)
DELETE {{baseUrl}}/article/{{articleId}}
Cookie: {{adminCookie}}

### ==================================================================
### Public
### ==================================================================

### Public - Home
GET {{baseUrl}}/public/home

###

### Public - Categories
GET {{baseUrl}}/public/categories

###

### Public - Featured
GET {{baseUrl}}/public/featured

###

### Public - Latest
GET {{baseUrl}}/public/latest

###

### Public - Trending
GET {{baseUrl}}/public/trending?limit=5

###

### Public - Archive
GET {{baseUrl}}/public/archive/2030/01

###

### Public - Sitemap
GET {{baseUrl}}/public/sitemap

###

### Public - Article by slug
GET {{baseUrl}}/public/article/{{slug}}

###

### Public - Invalid article slug (negative)
GET {{baseUrl}}/public/article/{{invalidSlug}}

###

### Public - Category by slug
GET {{baseUrl}}/public/category/{{categorySlug}}

###

### Public - Invalid category slug (negative)
GET {{baseUrl}}/public/category/{{invalidSlug}}

###

### Public - Search
GET {{baseUrl}}/public/search?q=api&limit=5

###

### Public - Invalid search query (negative)
GET {{baseUrl}}/public/search?q=

###

### Auth - Logout admin (run at the end)
POST {{baseUrl}}/auth/logout
Cookie: {{adminCookie}}
